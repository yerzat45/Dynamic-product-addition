# Webhook с доступами CRM (сделки, товары) от технического пользователя
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.kz/rest/1/REPLACE_WITH_SECRET/
# Секретный ключ для запуска обработчика из БП (минимум 16 символов)
SYNC_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
PORT=3080
HOST=127.0.0.1
# true: реальные изменения ЗАПРЕЩЕНЫ (сначала протестировать)
DRY_RUN=true
# append: сохранить прочие товары и добавить недостающий объект
# strict: оставить ровно один соответствующий товар (удалит остальные строки!)
SYNC_MODE=append
# Не синхронизировать, если поля уже начали меняться в ходе обработки
RECHECK_DEAL=true
# SSL: выставить true только за доверенным reverse proxy
TRUST_PROXY=false
